From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Mon, 16 Nov 2026 15:20:09 +0000
Subject: [PATCH] Rebuild an evicted root whose text wrapping or inline
 decorations changed

A root evicted from shaping keeps the break summary it took under the style of the time, and only
RELAYOUT damage reached it when the style changed how text breaks, so it laid out from the old
summary. Compare the wrap mode and tab size too, and an inline span's padding, border and radius,
which parley bakes into line breaking when the layout is built. Either sends the rebuild path
ALL_DAMAGE. The background brush is left out of the decoration comparison because stylo.rs already
handles a change in background presence.
---
 src/layout/damage.rs   |  6 ++++--
 src/stylo_to_parley.rs | 13 +++++++++++++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/src/layout/damage.rs b/src/layout/damage.rs
index 4193e6e..dda2ad1 100644
--- a/src/layout/damage.rs
+++ b/src/layout/damage.rs
@@ -565,12 +565,14 @@ pub(crate) fn compute_layout_damage(old: &ComputedValues, new: &ComputedValues)
                 || old_text.overflow_wrap != new_text.overflow_wrap
                 || old_text.letter_spacing != new_text.letter_spacing
                 || old_text.word_spacing != new_text.word_spacing
-                || old_text.text_rendering != new_text.text_rendering)
+                || old_text.text_rendering != new_text.text_rendering
+                || old_text.text_wrap_mode != new_text.text_wrap_mode
+                || old_text.tab_size != new_text.tab_size)
         {
             return true;
         }

-        false
+        crate::stylo_to_parley::inline_box_decorations_differ(old, new)
     };

     #[allow(
diff --git a/src/stylo_to_parley.rs b/src/stylo_to_parley.rs
index 2387f62..d404a3f 100644
--- a/src/stylo_to_parley.rs
+++ b/src/stylo_to_parley.rs
@@ -551,5 +551,18 @@ fn extract_box_decorations(
     }
 }

+/// Whether an inline span's parley decorations differ between the styles. Padding and border
+/// are baked into line breaking when the layout is built; background presence is handled apart.
+pub(crate) fn inline_box_decorations_differ(
+    old: &stylo::ComputedValues,
+    new: &stylo::ComputedValues,
+) -> bool {
+    let without_background = |style| parley::BoxDecorations {
+        background_brush: None,
+        ..extract_box_decorations(NodeId::default(), style)
+    };
+    without_background(old) != without_background(new)
+}
+
 pub(crate) fn has_inline_background(style: &stylo::ComputedValues) -> bool {
     use ::style::values::specified::box_::{DisplayInside, DisplayOutside};
