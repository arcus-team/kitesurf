From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Mon, 16 Nov 2026 14:53:38 +0000
Subject: [PATCH] Record the display when a node is shown again

A table row, a row group, a flattened inline and a display:contents element are consumed by
collection passes that do not write display_constructed_as, so storing none when they are hidden
left it there after they were shown: the has-box walks then stopped at them and every geometry read
below answered an empty rect.
---
 src/layout/damage.rs | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/layout/damage.rs b/src/layout/damage.rs
index eb33360..4193e6e 100644
--- a/src/layout/damage.rs
+++ b/src/layout/damage.rs
@@ -86,10 +86,19 @@ impl BaseDocument {
         if own_damage.contains(CONSTRUCT_BOX) {
             let node = &self.nodes[node_id];
             let was_displayed = !is_display_none(*node.display_constructed_as());
-            if let Some(display) = node.display_style().filter(|d| is_display_none(*d)) {
+            let display = node.display_style();
+            if let Some(display) = display.filter(|d| is_display_none(*d)) {
                 if was_displayed {
                     self.release_undisplayed_layout(node_id);
                     *self.nodes[node_id].display_constructed_as_mut() = display;
                 }
+            } else if !was_displayed {
+                // Shown again. Box construction records the display for the nodes it collects as
+                // layout children, but a table row, a row group, a flattened inline and a
+                // display:contents element are consumed elsewhere and would keep the `none` that
+                // the has-box walks stop at, so record it here.
+                if let Some(display) = display {
+                    *self.nodes[node_id].display_constructed_as_mut() = display;
+                }
             }
         }
