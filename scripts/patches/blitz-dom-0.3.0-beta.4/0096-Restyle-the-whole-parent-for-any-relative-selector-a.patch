From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Mon, 16 Nov 2026 15:53:14 +0000
Subject: [PATCH] Restyle the whole parent for any relative selector and for
 dir=auto

An insertion restyled the whole parent only when some relative selector started with a sibling
combinator, but a :has() anchored on the parent with a structural argument also changes on an
insertion, and the invalidator collects dependencies from the inserted element's own id, class and
attributes, so a plain span has none. dir=auto and <bdi> take their direction from descendant text,
which no selector flag covers.
---
 src/mutator.rs | 25 +++++++++++++++++--------
 src/stylo.rs   | 22 +---------------------
 2 files changed, 18 insertions(+), 29 deletions(-)

diff --git a/src/mutator.rs b/src/mutator.rs
index 493ce5b..8f37fc8 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -30,11 +30,20 @@ fn insertion_restyles_whole_parent(parent: &Node) -> bool {
     {
         return true;
     }
-    parent.selector_flags().get().intersects(
-        ElementSelectorFlags::HAS_EMPTY_SELECTOR
-            | ElementSelectorFlags::HAS_SLOW_SELECTOR
-            | ElementSelectorFlags::MAY_HAVE_TREE_COUNTING_FUNCTION,
-    )
+    // `dir=auto` and `<bdi>` take their direction from their descendants' text, and no selector
+    // flag covers that.
+    let direction_from_content = parent
+        .element_data()
+        .is_some_and(|data| data.name.local == local_name!("bdi"))
+        || parent
+            .attr(local_name!("dir"))
+            .is_some_and(|dir| dir.eq_ignore_ascii_case("auto"));
+    direction_from_content
+        || parent.selector_flags().get().intersects(
+            ElementSelectorFlags::HAS_EMPTY_SELECTOR
+                | ElementSelectorFlags::HAS_SLOW_SELECTOR
+                | ElementSelectorFlags::MAY_HAVE_TREE_COUNTING_FUNCTION,
+        )
 }

 macro_rules! tag_and_attr {
@@ -1030,13 +1039,13 @@ impl DocumentMutator<'_> {
             self.maybe_record_node(old_parent_id);
         }

-        let has_sibling_relative_selectors =
-            new_parent_is_in_document && self.doc.has_sibling_relative_selectors();
+        let has_relative_selectors =
+            new_parent_is_in_document && self.doc.has_relative_selectors();
         let new_parent = &mut self.doc.nodes[parent_id];
         new_parent.insert_damage(ALL_DAMAGE);

         let restyle_whole_parent = new_parent_is_in_document
-            && (insertion_restyles_whole_parent(new_parent) || has_sibling_relative_selectors);
+            && (insertion_restyles_whole_parent(new_parent) || has_relative_selectors);
         if new_parent_is_in_document {
             if restyle_whole_parent {
                 if let Some(mut data) = new_parent
diff --git a/src/stylo.rs b/src/stylo.rs
index 48f5b79..9a5d837 100644
--- a/src/stylo.rs
+++ b/src/stylo.rs
@@ -382,7 +382,7 @@ impl crate::document::BaseDocument {
     ///
     /// `iter_origins` only sees document-level origins, so any shadow root
     /// forces the slow path rather than risk missing a shadow `:has()`.
-    fn has_relative_selectors(&self) -> bool {
+    pub(crate) fn has_relative_selectors(&self) -> bool {
         !self.shadow_roots.is_empty()
             || self
                 .stylist
@@ -390,26 +390,6 @@ impl crate::document::BaseDocument {
                 .any(|(data, _)| data.relative_invalidation_map_attributes().used)
     }

-    /// Whether some `:has()` starts with `+` or `~`, in the document or any shadow tree, so
-    /// an inserted element can change an earlier sibling's match. An inserted element only
-    /// inherits its parent's search direction, which never carries the sibling one, so the
-    /// invalidator misses those anchors and the insertion must restyle the whole parent.
-    pub(crate) fn has_sibling_relative_selectors(&self) -> bool {
-        let reaches_siblings = |data: &style::stylist::CascadeData| {
-            data.relative_invalidation_map_attributes()
-                .has_sibling_relative_selectors
-        };
-        self.stylist
-            .iter_origins()
-            .any(|(data, _)| reaches_siblings(data))
-            || self.shadow_roots.iter().any(|&id| {
-                self.nodes
-                    .get(id)
-                    .and_then(|node| node.shadow_root_data())
-                    .is_some_and(|data| reaches_siblings(&data.author_styles.data))
-            })
-    }
-
     /// Structural sibling of the pass above, for tree mutations rather than
     /// attribute and state ones. Snapshots only exist for the latter, so an
     /// insert or remove has to invalidate at mutation time.
